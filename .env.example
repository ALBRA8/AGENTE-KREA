# ═══════════════════════════════════════════════════════════════
# KREA — Variables de entorno
# Copia este archivo a .env y ajusta los valores. NUNCA hagas commit de .env.
# ═══════════════════════════════════════════════════════════════

# ── Base de datos (SQLite local; usa una ruta persistente en despliegue) ──
DATABASE_URL="file:./db/custom.db"

# ── Proveedor IA (z.ai) ──
# Clave del SDK. Si falta, las capacidades de generación devuelven error 503
# y /api/doctor la reporta como NOT_VERIFIED.
ZAI_API_KEY=""

# ── Modo demo ──
# false (default): /api/auth/auto-login responde 403 y NO crea usuarios.
# true (solo desarrollo/demo): permite auto-login con contraseña aleatoria
# efímera, generada en cada arranque (ver logs del servidor).
DEMO_MODE=false

# ── CORS (opcional) ──
# Orígenes permitidos separados por comas. Vacío = solo same-origin.
CORS_ORIGINS=""

# ── Export ecommerce (/api/commercial/export) ──
# Con estas credenciales la ruta hace el envío HTTP REAL a la API de la
# plataforma (ver CREDENTIAL_ENV_VARS en src/lib/commercial/ecom-export.ts).
# Sin ellas, la ruta prepara el payload y lista qué env vars faltan (honesto).
# Shopify (Admin API, token con scope write_products):
KREA_SHOPIFY_STORE="mitienda.myshopify.com"
KREA_SHOPIFY_ADMIN_TOKEN=""
# KREA_SHOPIFY_API_VERSION="2024-01"
# WooCommerce (REST v3, HTTPS obligatorio para Basic auth):
KREA_WOOCOMMERCE_URL=""
KREA_WOOCOMMERCE_CONSUMER_KEY=""
KREA_WOOCOMMERCE_CONSUMER_SECRET=""
# TiendaNube (API v1; token de app con permiso de productos):
KREA_TIENDANUBE_STORE_ID=""
KREA_TIENDANUBE_API_TOKEN=""
# KREA_TIENDANUBE_USER_AGENT="AGENTE-KREA/1.0 (ecom-export)"
# Funnelish: sin API pública REST de imágenes de producto — modo real no disponible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  credits   Int      @default(50)
  plan      String   @default("starter")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations     Generation[]
  campaignEntries CampaignEntry[]
  memories        Memory[]
  executions      Execution[]
  feedbacks       Feedback[]
  auditEvents     AuditEvent[]
  sessions        Session[]
  opportunities     ProductOpportunity[]
  dossiers          ProductDossier[]
  commercialProducts CommercialProduct[]
  blueprints        ProductBlueprint[]
  assets            ProductAsset[]
  factoryExecutions FactoryExecution[]
  versionRecords    ProductVersionRecord[]
  launchPackages    LaunchPackage[]
  commercialFeedbacks CommercialFeedback[]
}

model CampaignEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  revenue   Float    @default(0)
  investment Float   @default(0)
  sales     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "image" | "text" | "voice" | "ebook" | "copy" | "subtitle"
  title     String
  prompt    String
  result    String   // URL for images/voice, text content for text/ebooks
  credits   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MemoryDV - Agent Memory System
model Memory {
  id            String   @id @default(cuid())
  agentId       String   @default("krea")
  userId        String?  // nullable = global agent memory, non-null = user-scoped
  domain        String   // e.g., "generation", "campaign", "product"
  type          String   // EPISODIC | SEMANTIC | FACTUAL | PROCEDURAL
  content       String   // JSON string for structured content
  source        String?  // where this memory came from
  sourceType    String?  // USER | AGENT | SYSTEM | EXTERNAL | FEEDBACK | INFERENCE
  evidence      String?  // JSON - evidence/provenance data
  confidence    Float    @default(0.5)
  truthLevel    String   @default("ESTIMATED") // OBSERVED|VERIFIED|ESTIMATED|MODELED|INFERRED|UNKNOWN
  relevance     Float    @default(1.0)
  utility       Float    @default(0.5)
  decay         Float    @default(0.0) // 0 = no decay, increases over time
  scope         String   @default("agent") // agent | user | global | ecosistema
  status        String   @default("ACTIVE") // ACTIVE | CONSOLIDATED | INVALIDATED | ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastVerified  DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Skill System
model Skill {
  id              String   @id @default(cuid())
  agentId         String   @default("krea")
  name            String
  description     String
  purpose         String
  trigger         String?  // when this skill activates
  prerequisites   String?  // JSON array of prerequisite skill IDs or conditions
  procedure       String   // JSON - structured procedure steps
  toolsRequired   String?  // JSON array of tool IDs
  expectedResult  String?
  verification    String?  // how to verify the skill worked
  pitfalls        String?  // JSON array of known pitfalls
  evidence        String?  // JSON - evidence data
  confidence      Float    @default(0.5)
  successRate     Float    @default(0.0)
  origin          String?  // MANUAL | LEARNED | FEEDBACK | IMPORTED
  version         Int      @default(1)
  status          String   @default("PROPOSED") // PROPOSED|VALIDATING|ACTIVE|DEPRECATED|RETIRED
  lastValidated   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentId, name, version])
}

// Execution Trace
model Execution {
  id            String   @id @default(cuid())
  agentId       String   @default("krea")
  userId        String?
  task          String
  toolsUsed     String?  // JSON array
  skillsUsed    String?  // JSON array
  inputs        String?  // JSON
  outputs       String?  // JSON
  errors        String?  // JSON array
  evidence      String?  // JSON
  approvals     String?  // JSON array
  cost          Float    @default(0)
  status        String   @default("PENDING") // PENDING|RUNNING|SUCCEEDED|FAILED|CANCELLED
  startedAt     DateTime?
  completedAt   DateTime?
  correlationId String?
  createdAt     DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks Feedback[]
}

// Feedback & Learning
model Feedback {
  id              String   @id @default(cuid())
  agentId         String   @default("krea")
  userId          String?
  executionId     String?  // link to execution
  input           String?  // JSON - what was the input
  result          String?  // JSON - what was the result
  feedbackType    String   // SUCCESS | PARTIAL_SUCCESS | FAILURE | TECHNICAL_ERROR | BAD_DECISION | BAD_HYPOTHESIS | BAD_TOOL | BAD_EXECUTION | UNKNOWN
  feedbackText    String?
  analysis        String?  // JSON - automated analysis
  learning        String?  // JSON - what was learned
  evidence        String?  // JSON
  confidence      Float    @default(0.5)
  validationStatus String @default("PENDING") // PENDING|VALIDATED|INVALIDATED
  createdAt       DateTime @default(now())

  execution Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Agent Interaction Log (agent-to-agent communication)
model AgentInteraction {
  id              String   @id @default(cuid())
  requesterAgent  String
  targetAgent     String
  objective       String
  input           String?  // JSON
  constraints     String?  // JSON
  requestedOutput String?  // JSON
  status          String   @default("PENDING") // PENDING|SENT|RECEIVED|SUCCEEDED|FAILED|TIMEOUT
  result          String?  // JSON
  evidence        String?  // JSON
  confidence      Float    @default(0.5)
  executionId     String?
  correlationId   String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

// Audit Event Log
model AuditEvent {
  id          String   @id @default(cuid())
  agentId     String   @default("krea")
  userId      String?
  action      String   // e.g., "generate_image", "deduct_credits", "skill_execute"
  resource    String?  // what was affected
  details     String?  // JSON
  result      String?  // SUCCESS | FAILURE | PARTIAL
  evidence    String?  // JSON
  ip          String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Session Management
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Product Opportunity — incoming product ideas
model ProductOpportunity {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  domain      String   // "ebook" | "software" | "saas" | "guide" | "template" | "kit"
  audience    String
  problem     String
  alternatives String? // JSON array of existing alternatives
  status      String   @default("EVALUATING") // EVALUATING | ACCEPTED | REJECTED | ARCHIVED
  fitScore    String?  // JSON - FitScore result
  decision    String?  // JSON - ProductDecision result
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossier ProductDossier?
}

// Product Dossier — master lifecycle tracker
model ProductDossier {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?  @unique
  title         String
  description   String
  domain        String
  status        String   @default("IDEA")
  // IDEA | RESEARCHING | EVALUATING | DECIDING | ARCHITECTING | SPECIFYING | PRODUCING | QA | REVISION | PUBLISHED | ARCHIVED | FAILED
  version       Int      @default(1)
  architecture  String?  // JSON - ProductArchitecture
  specification String?  // JSON - ProductSpecification
  economics     String?  // JSON - ProductEconomics
  handoffId     String?  // link to Handoff
  artifacts     String?  // JSON array of artifact paths
  timeline      String?  // JSON array of timeline entries
  parentDossierId String? // for revision chain — link to previous version
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity ProductOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  handoff     Handoff?
  commercialProduct CommercialProduct? // one-to-one via productId
  blueprint        ProductBlueprint?   // one-to-one via productId
}

// Handoff — provider-neutral delivery contract
model Handoff {
  id              String   @id @default(cuid())
  dossierId       String   @unique
  sourceAgent     String   @default("KREA")
  targetProvider  String   // "codex" | "antigravity" | "generic" | "manual"
  objective       String
  productId       String
  productVersion  String   @default("1.0.0")
  specification   String?  // JSON
  constraints     String?  // JSON array
  acceptanceCriteria String? // JSON array
  dependencies    String?  // JSON array
  evidence        String?  // JSON
  risk            String?  // JSON array
  autonomy        String   @default("SUPERVISED") // SUPERVISED | SEMI_AUTONOMOUS | AUTONOMOUS
  approvals       String?  // JSON array
  status          String   @default("CREATED") // CREATED | READY | SENT | ACKNOWLEDGED | COMPLETED | FAILED | CANCELLED
  deliveryAttempts Int     @default(0)
  error           String?
  externalSendStatus String? @default("NOT_VERIFIED") // VERIFIED | NOT_VERIFIED | NOT_AVAILABLE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dossier ProductDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
}

// Commercial Product Definition
model CommercialProduct {
  id              String   @id @default(cuid())
  userId          String
  productId       String   @unique
  productVersion  String   @default("1.0.0")
  productName     String
  productType     String   // ebook | guide | manual | workbook | etc.
  targetCustomer  String   // JSON
  problem         String
  jobToBeDone     String
  desiredOutcome  String
  valueProposition String
  differentiation String
  format          String
  includedAssets  String   @default("[]") // JSON array
  excludedScope   String   @default("[]") // JSON array
  priceStrategy   String   // JSON
  priceRange      String   // JSON
  monetizationModel String
  distributionStrategy String
  positioning     String
  keyBenefits     String   @default("[]") // JSON array
  objections      String   @default("[]") // JSON array
  proofRequirements String @default("[]") // JSON array
  commercialReadiness String? // JSON
  launchRequirements String @default("[]") // JSON array
  assumptions     String   @default("[]") // JSON array
  risks           String   @default("[]") // JSON array
  evidence        String   @default("INFERRED")
  provenance      String   @default("product_brain")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossier ProductDossier? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Product Blueprint
model ProductBlueprint {
  id                  String   @id @default(cuid())
  userId              String
  blueprintId         String   @unique
  productId           String   @unique
  version             String   @default("1.0.0")
  type                String
  customer            String   // JSON
  problem             String
  jobToBeDone         String
  desiredOutcome      String
  valueProposition    String
  format              String
  structure           String   // JSON
  contentRequirements String   @default("[]") // JSON array
  designRequirements  String   @default("[]") // JSON array
  assetRequirements   String   @default("[]") // JSON array
  commercialRequirements String @default("[]") // JSON array
  qualityRequirements String   @default("[]") // JSON array
  deliveryRequirements String  @default("[]") // JSON array
  successCriteria     String   @default("[]") // JSON array
  assumptions         String   @default("[]") // JSON array
  risks               String   @default("[]") // JSON array
  evidence            String   @default("INFERRED")
  provenance          String   @default("product_brain")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossier ProductDossier? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Product Asset
model ProductAsset {
  id          String   @id @default(cuid())
  userId      String
  assetId     String   @unique
  productId   String
  version     String   @default("1.0.0")
  type        String   // pdf | epub | image | cover | metadata | markdown | template | data
  filename    String
  mimeType    String
  path        String
  size        Int      @default(0)
  checksum    String
  source      String   // which factory
  provider    String   // which provider
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED | DELETED
  evidence    String   @default("VERIFIED")
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Factory Execution
model FactoryExecution {
  id            String   @id @default(cuid())
  userId        String
  executionId   String   @unique
  productId     String
  factoryType   String
  contract      String   // JSON FactoryContract
  status        String   @default("CREATED") // CREATED|QUEUED|RUNNING|QA|PASSED|FAILED|REPAIRING|COMPLETED|CANCELLED
  progress      String   @default("[]") // JSON StepProgress array
  artifacts     String   @default("[]") // JSON ArtifactRef array
  qaReport      String?  // JSON
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Product Version
model ProductVersionRecord {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  version     String
  blueprintId String?
  dossierId   String?
  executionId String?
  assets      String   @default("[]") // JSON array of asset IDs
  qaPassed    Boolean  @default(false)
  changes     String   @default("")
  feedback    String   @default("[]") // JSON array
  parentId    String?  // previous version productId
  status      String   @default("DRAFT") // DRAFT|PUBLISHED|ARCHIVED|SUPERSEDE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, version])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Launch Package
model LaunchPackage {
  id              String   @id @default(cuid())
  userId          String
  packageId       String   @unique
  productId       String
  version         String   @default("1.0.0")
  product         String   // JSON
  offer           String   // JSON
  positioning     String
  targetCustomer  String   // JSON
  corePromise     String
  benefits        String   @default("[]") // JSON
  included        String   @default("[]") // JSON
  bonuses         String   @default("[]") // JSON
  price           String   // JSON
  delivery        String   // JSON
  faq             String   @default("[]") // JSON
  objections      String   @default("[]") // JSON
  cta             String
  assets          String   @default("[]") // JSON
  proofStatus     String   @default("[]") // JSON
  disclaimers     String   @default("[]") // JSON
  integrityCheck  String   @default("{}") // JSON
  evidence        String   @default("INFERRED")
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Commercial Feedback
model CommercialFeedback {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  version     String   @default("1.0.0")
  feedbackType String  // POSITIVE | NEGATIVE | OBJECTION | FEATURE_REQUEST | CONTENT_GAP | USABILITY | PURCHASE_BARRIER
  category    String   // PRODUCT | CONTENT | DESIGN | PRICE | POSITIONING | DELIVERY | MARKETING | OTHER
  content     String
  source      String   @default("user")
  analyzed    Boolean  @default(false)
  analysis    String?  // JSON
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

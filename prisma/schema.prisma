generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  credits   Int      @default(50)
  plan      String   @default("starter")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations Generation[]
  campaignEntries CampaignEntry[]
}

model CampaignEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  revenue   Float    @default(0)
  investment Float   @default(0)
  sales     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "image" | "text" | "voice" | "ebook" | "copy" | "subtitle"
  title     String
  prompt    String
  result    String   // URL for images/voice, text content for text/ebooks
  credits   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}